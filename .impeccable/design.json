  "components": [
    {
      "name": "主要按钮",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "导入或保存等主要操作，夜间独立填色。",
      "html": "<button class=\"ds-primary\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 16V3m-5 5 5-5 5 5M4 15v4a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-4\"/></svg>导入课表</button>",
      "css": ".ds-primary{font-family:-apple-system,BlinkMacSystemFont,'HarmonyOS Sans SC','PingFang SC','Microsoft YaHei',sans-serif;font-variant-numeric:tabular-nums;}.ds-primary{display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:46px;padding:0 19px;background:var(--green,#3157d5);color:#fff;border:0;border-radius:12px;font-size:14px;font-weight:600;cursor:pointer;transition:background 160ms ease-out}.ds-primary:hover{background:#2448bd}.ds-primary:focus-visible{outline:3px solid var(--focus,#3157d5);outline-offset:3px;}.ds-primary:disabled{opacity:.5;cursor:not-allowed}@media(prefers-color-scheme:dark){.ds-primary{background:#4268e1}.ds-primary:hover{background:#5176ec}}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}"
    },
    {
      "name": "次要按钮",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "添加等次要入口，内容面配轻边界。",
      "html": "<button class=\"ds-secondary\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 5v14M5 12h14\"/></svg>添加课程</button>",
      "css": ".ds-secondary{font-family:-apple-system,BlinkMacSystemFont,'HarmonyOS Sans SC','PingFang SC','Microsoft YaHei',sans-serif;font-variant-numeric:tabular-nums;}.ds-secondary{display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:44px;padding:0 15px;border:1px solid var(--line,#e0e5ef);border-radius:12px;background:var(--surface,#fff);color:var(--ink,#1b2438);font-size:14px;font-weight:600;cursor:pointer;transition:background 160ms ease-out}.ds-secondary:hover{background:var(--soft,#ebeff8)}.ds-secondary:focus-visible{outline:3px solid var(--focus,#3157d5);outline-offset:3px;}.ds-secondary:disabled{opacity:.5;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-secondary{transition:none}}"
    },
    {
      "name": "文字按钮",
      "kind": "button",
      "refersTo": "button-text",
      "description": "回到今天、设置与辅助动作。",
      "html": "<button class=\"ds-text\">回到今天<svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m9 5 7 7-7 7\"/></svg></button>",
      "css": ".ds-text{font-family:-apple-system,BlinkMacSystemFont,'HarmonyOS Sans SC','PingFang SC','Microsoft YaHei',sans-serif;font-variant-numeric:tabular-nums;}.ds-text{display:inline-flex;align-items:center;justify-content:center;gap:6px;min-height:44px;padding:0 6px;border:0;background:transparent;color:var(--green,#3157d5);font-size:13px;font-weight:600;cursor:pointer}.ds-text svg{width:17px;height:17px}.ds-text:hover{background:var(--soft,#ebeff8);text-decoration:underline;text-underline-offset:4px}.ds-text:focus-visible{outline:3px solid var(--focus,#3157d5);outline-offset:3px;}.ds-text:disabled{opacity:.5;cursor:not-allowed}"
    },
    {
      "name": "字段输入",
      "kind": "input",
      "refersTo": "input-field",
      "description": "课程名称、地点等单行字段，显式标签。",
      "html": "<label class=\"ds-field\">上课地点<input type=\"text\" placeholder=\"例如：信息楼 502\" value=\"信息楼 502\"></label>",
      "css": ".ds-field{font-family:-apple-system,BlinkMacSystemFont,'HarmonyOS Sans SC','PingFang SC','Microsoft YaHei',sans-serif;font-variant-numeric:tabular-nums;}.ds-field{display:block;font-size:14px;line-height:1.7;color:var(--ink,#1b2438)}.ds-field input{display:block;box-sizing:border-box;width:100%;min-height:44px;margin-top:7px;padding:11px 12px;border:1px solid var(--line,#e0e5ef);border-radius:10px;background:var(--surface,#fff);color:var(--ink,#1b2438);font-family:inherit;font-size:16px;caret-color:var(--green,#3157d5)}.ds-field input:focus-visible{outline:3px solid var(--focus,#3157d5);outline-offset:3px;}.ds-field input:disabled{opacity:.5;cursor:not-allowed}"
    },
    {
      "name": "主导航",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "桌面侧栏，窄屏四项底栏示例。",
      "html": "<nav class=\"ds-nav\" aria-label=\"主导航\"><button class=\"ds-nav-item ds-nav-current\" aria-current=\"page\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"3\" y=\"5\" width=\"18\" height=\"16\" rx=\"3\"/><path d=\"M16 3v4M8 3v4M3 11h18\"/></svg><span>课表</span></button><button class=\"ds-nav-item\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 16V3m-5 5 5-5 5 5M4 15v4a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-4\"/></svg><span>导入</span></button><button class=\"ds-nav-item\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 7v5l3 2\"/></svg><span>闹钟</span></button><button class=\"ds-nav-item\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m9 3-1 3-3 1 1 3-2 2 2 2-1 3 3 1 1 3h6l1-3 3-1-1-3 2-2-2-2 1-3-3-1-1-3Z\"/><circle cx=\"12\" cy=\"12\" r=\"3\"/></svg><span>设置</span></button></nav>",
      "css": ".ds-nav{font-family:-apple-system,BlinkMacSystemFont,'HarmonyOS Sans SC','PingFang SC','Microsoft YaHei',sans-serif;font-variant-numeric:tabular-nums;}.ds-nav{display:flex;flex-direction:column;gap:8px;max-width:174px}.ds-nav-item{display:flex;align-items:center;gap:12px;min-height:52px;padding:0 16px;border:0;border-radius:12px;background:transparent;color:var(--muted,#626f86);font-family:inherit;font-size:15px;cursor:pointer;transition:background 160ms ease-out,color 160ms ease-out}.ds-nav-current{background:#e3eaff;color:var(--green,#3157d5);font-weight:650}.ds-nav-current svg{stroke-width:2.2}.ds-nav-item:focus-visible{outline:3px solid var(--focus,#3157d5);outline-offset:3px;}@media(max-width:1023px){.ds-nav{max-width:none;flex-direction:row;justify-content:space-around;background:var(--surface,#fff);border-top:1px solid var(--line,#e0e5ef);padding:8px 12px;gap:4px}.ds-nav-item{flex:1;flex-direction:column;justify-content:center;gap:3px;padding:6px 10px;font-size:12px}.ds-nav-current{background:var(--soft,#ebeff8)}}@media(prefers-color-scheme:dark){.ds-nav-current{background:var(--soft,#27334c)}}@media(prefers-reduced-motion:reduce){.ds-nav-item{transition:none}}"
    },
    {
      "name": "一周日期片",
      "kind": "chip",
      "refersTo": "date-chip",
      "description": "七日数据，触控五项、极窄屏三项；示例周四选中。",
      "html": "<div class=\"ds-dates\"><button class=\"ds-date\" aria-label=\"10月12日 周一\" aria-pressed=\"false\"><span>一</span><strong>12</strong><i></i></button><button class=\"ds-date\" aria-label=\"10月13日 周二\" aria-pressed=\"false\"><span>二</span><strong>13</strong><i></i></button><button class=\"ds-date\" aria-label=\"10月14日 周三\" aria-pressed=\"false\"><span>三</span><strong>14</strong><i></i></button><button class=\"ds-date ds-date-selected\" aria-label=\"10月15日 周四\" aria-pressed=\"true\"><span>四</span><strong>15</strong><i></i></button><button class=\"ds-date\" aria-label=\"10月16日 周五\" aria-pressed=\"false\"><span>五</span><strong>16</strong><i></i></button><button class=\"ds-date\" aria-label=\"10月17日 周六\" aria-pressed=\"false\"><span>六</span><strong>17</strong><i></i></button><button class=\"ds-date\" aria-label=\"10月18日 周日\" aria-pressed=\"false\"><span>日</span><strong>18</strong><i></i></button></div>",
      "css": ".ds-dates{font-family:-apple-system,BlinkMacSystemFont,'HarmonyOS Sans SC','PingFang SC','Microsoft YaHei',sans-serif;font-variant-numeric:tabular-nums;}.ds-dates{display:grid;grid-template-columns:repeat(7,minmax(44px,1fr));gap:8px;overflow-x:auto;scroll-snap-type:x mandatory}.ds-date{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:0;min-height:70px;min-width:44px;padding:0;border:0;border-radius:13px;background:transparent;color:var(--muted,#626f86);font-family:inherit;cursor:pointer;scroll-snap-align:center;transition:background 160ms ease-out,color 160ms ease-out}.ds-date span{font-size:12px;line-height:1.6}.ds-date strong{font-size:20px;font-weight:650;line-height:1.5;color:var(--ink,#1b2438)}.ds-date i{width:4px;height:4px;margin-top:3px;background:#9aa9c5;border-radius:50%}.ds-date-selected{background:var(--green,#3157d5);color:#fff}.ds-date-selected strong{color:#fff}.ds-date-selected i{background:#fff}.ds-date:focus-visible{outline:3px solid var(--focus,#3157d5);outline-offset:3px;}@media(max-width:760px){.ds-dates{grid-template-columns:none;grid-auto-flow:column;grid-auto-columns:calc((100% - 20px)/5);gap:5px}.ds-date{min-width:0;min-height:65px;border-radius:12px;scroll-snap-align:start}.ds-date strong{font-size:19px}}@media(max-width:359px){.ds-dates{grid-auto-columns:calc((100% - 10px)/3)}}@media(prefers-color-scheme:dark){.ds-date-selected{background:#4268e1}}@media(prefers-reduced-motion:reduce){.ds-date{transition:none}}"
    },
    {
      "name": "视图分段",
      "kind": "custom",
      "refersTo": "segmented",
      "description": "日程/周课表控件示例，仅展示状态，无应用路由。",
      "html": "<div class=\"ds-segmented\" role=\"group\" aria-label=\"课表视图\"><button class=\"ds-segment-selected\" aria-pressed=\"true\">日程</button><button aria-pressed=\"false\">周课表</button></div>",
      "css": ".ds-segmented{font-family:-apple-system,BlinkMacSystemFont,'HarmonyOS Sans SC','PingFang SC','Microsoft YaHei',sans-serif;font-variant-numeric:tabular-nums;}.ds-segmented{display:inline-flex;gap:2px;padding:4px;border-radius:12px;background:var(--soft,#ebeff8)}.ds-segmented button{min-height:40px;padding:0 18px;border:0;border-radius:9px;background:transparent;color:var(--muted,#626f86);font-family:inherit;font-size:14px;cursor:pointer}.ds-segmented .ds-segment-selected{background:var(--surface,#fff);color:var(--ink,#1b2438);box-shadow:0 2px 5px #1b24380a}.ds-segmented button:focus-visible{outline:3px solid var(--focus,#3157d5);outline-offset:3px;}"
    },
    {
      "name": "下一节课程",
      "kind": "card",
      "refersTo": "next-lesson",
      "description": "深蓝重点面；长课程名和地点换行。",
      "html": "<section class=\"ds-next\"><div class=\"ds-next-heading\"><h2>下一节课</h2><span>30 分钟后</span></div><button class=\"ds-next-course\"><strong>信息检索与利用</strong><span class=\"ds-next-meta\"><span><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 7v5l3 2\"/></svg>14:00–15:40</span><span><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M19 10c0 5-7 11-7 11S5 15 5 10a7 7 0 0 1 14 0Z\"/><circle cx=\"12\" cy=\"10\" r=\"2\"/></svg>信息楼 502</span></span><span class=\"ds-next-open\">查看课程<svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m9 5 7 7-7 7\"/></svg></span></button></section>",
      "css": ".ds-next{font-family:-apple-system,BlinkMacSystemFont,'HarmonyOS Sans SC','PingFang SC','Microsoft YaHei',sans-serif;font-variant-numeric:tabular-nums;}.ds-next{background:var(--next-bg,#202e55);color:var(--next-ink,#fff);padding:22px 24px;border-radius:16px}.ds-next-heading{display:flex;justify-content:space-between;align-items:center;gap:14px;margin-bottom:15px}.ds-next-heading h2{margin:0;font-size:14px;font-weight:500;line-height:1.4}.ds-next-heading>span{font-size:13px;color:var(--next-muted,#d0daf2)}.ds-next-course{display:block;width:100%;text-align:left;padding:0;border:0;background:transparent;color:inherit;font-family:inherit;cursor:pointer}.ds-next-course>strong{display:block;font-size:24px;line-height:1.45;font-weight:650;overflow-wrap:anywhere}.ds-next-meta{display:flex;flex-wrap:wrap;gap:8px 18px;margin-top:12px;color:var(--next-muted,#d0daf2);font-size:14px}.ds-next-meta>span{display:flex;align-items:center;gap:6px;min-width:0;overflow-wrap:anywhere}.ds-next-meta svg,.ds-next-open svg{width:16px;height:16px;flex-shrink:0}.ds-next-open{display:flex;align-items:center;justify-content:flex-end;gap:5px;margin-top:15px;color:var(--next-muted,#d0daf2);font-size:12px}.ds-next-course:focus-visible{outline:3px solid var(--focus,#3157d5);outline-offset:3px;}@media(max-width:760px){.ds-next{padding:20px;border-radius:15px}.ds-next-course>strong{font-size:22px}.ds-next-meta{font-size:13px;gap:7px 15px;margin-top:10px}.ds-next-open{margin-top:12px}}"
    },
    {
      "name": "明日起床",
      "kind": "card",
      "refersTo": "wake-card",
      "description": "浅黄功能区；网页预览文字明确不表示已保存。",
      "html": "<section class=\"ds-wake\"><div class=\"ds-wake-heading\"><h2>明日起床</h2><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"4\"/><path d=\"M12 1v2M12 21v2M1 12h2M21 12h2M4 4l2 2M18 18l2 2M4 20l2-2M18 6l2-2\"/></svg></div><button class=\"ds-wake-time\" aria-label=\"查看明早起床计划\">07:00<svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m9 5 7 7-7 7\"/></svg></button><div class=\"ds-wake-copy\"><strong>08:30 首课 · 提前 90 分钟</strong><span>信息检索与利用</span><small>网页预览，不设置系统闹钟</small></div></section>",
      "css": ".ds-wake{font-family:-apple-system,BlinkMacSystemFont,'HarmonyOS Sans SC','PingFang SC','Microsoft YaHei',sans-serif;font-variant-numeric:tabular-nums;}.ds-wake{padding:22px 24px;border:0;border-radius:16px;background:var(--wake-bg,#fff0ae);color:var(--wake-ink,#443a0a)}.ds-wake-heading{display:flex;align-items:center;justify-content:space-between;margin-bottom:6px}.ds-wake-heading h2{margin:0;font-size:15px;font-weight:600;line-height:1.4}.ds-wake-time{display:flex;align-items:center;justify-content:space-between;gap:10px;width:100%;padding:4px 0;border:0;background:transparent;text-align:left;color:inherit;font-family:inherit;font-size:44px;font-weight:700;line-height:1.4;letter-spacing:-.035em;cursor:pointer}.ds-wake-copy{display:flex;flex-direction:column;gap:5px;margin-top:6px;min-width:0}.ds-wake-copy strong{font-size:14px;font-weight:500}.ds-wake-copy>span{font-size:13px;overflow-wrap:anywhere}.ds-wake-copy small{font-size:12px;margin-top:9px;padding-top:10px;border-top:1px solid #caba73;line-height:1.6}.ds-wake-time:focus-visible{outline:3px solid var(--focus,#3157d5);outline-offset:3px;}@media(max-width:760px){.ds-wake{display:grid;grid-template-columns:minmax(0,1fr) auto;grid-template-areas:\"heading time\" \"copy time\";gap:0 14px;padding:17px 20px;border-radius:15px}.ds-wake-heading{grid-area:heading;justify-content:flex-start;gap:8px}.ds-wake-heading h2{font-size:14px}.ds-wake-heading svg{width:17px;height:17px}.ds-wake-time{grid-area:time;width:auto;max-width:150px;font-size:36px;gap:5px}.ds-wake-time svg{width:16px;height:16px}.ds-wake-copy{grid-area:copy;margin-top:0;gap:3px}.ds-wake-copy strong{font-size:13px}.ds-wake-copy>span{font-size:12px}.ds-wake-copy small{border:0;padding:0;margin-top:5px}}@media(prefers-color-scheme:dark){.ds-wake-copy small{border-color:#b29a47}}"
    },
    {
      "name": "课程时间行",
      "kind": "card",
      "refersTo": "course-row",
      "description": "中性日程行；示例进行中，时间、地点和状态同时可读。",
      "html": "<button class=\"ds-course ds-course-current\"><span class=\"ds-course-time\">14:00<small>15:40</small></span><span class=\"ds-course-info\"><strong>信息检索与利用</strong><small><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M19 10c0 5-7 11-7 11S5 15 5 10a7 7 0 0 1 14 0Z\"/><circle cx=\"12\" cy=\"10\" r=\"2\"/></svg>信息楼 502</small><span class=\"ds-course-progress\" role=\"progressbar\" aria-label=\"当前课程进度\" aria-valuenow=\"40\" aria-valuemin=\"0\" aria-valuemax=\"100\"><i></i></span></span><span class=\"ds-course-state\">进行中</span><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m9 5 7 7-7 7\"/></svg></button>",
      "css": ".ds-course{font-family:-apple-system,BlinkMacSystemFont,'HarmonyOS Sans SC','PingFang SC','Microsoft YaHei',sans-serif;font-variant-numeric:tabular-nums;}.ds-course{display:grid;grid-template-columns:64px minmax(0,1fr) auto 16px;align-items:center;gap:14px;width:100%;min-height:106px;padding:19px 20px;border:0;border-radius:14px;background:var(--surface,#fff);color:var(--ink,#1b2438);box-shadow:none;text-align:left;cursor:pointer}.ds-course-current{outline:1px solid var(--green,#3157d5);outline-offset:0}.ds-course:hover{background:var(--soft,#ebeff8)}.ds-course-time{font-size:19px;font-weight:650;line-height:1.5}.ds-course-time small{display:block;font-size:13px;font-weight:400;color:var(--muted,#626f86)}.ds-course-info{min-width:0}.ds-course-info strong{font-size:17px;font-weight:650;line-height:1.5;overflow-wrap:anywhere}.ds-course-info>small{display:flex;align-items:center;gap:5px;margin-top:5px;font-size:13px;line-height:1.6;color:var(--muted,#626f86);overflow-wrap:anywhere}.ds-course-info svg{width:14px;height:14px;flex-shrink:0}.ds-course-state{font-size:12px;font-weight:600;white-space:nowrap;color:var(--green,#3157d5)}.ds-course>svg{width:16px;height:16px;color:var(--muted,#626f86)}.ds-course-progress{display:block;height:3px;border-radius:2px;background:var(--soft,#ebeff8);margin-top:12px;overflow:hidden}.ds-course-progress i{display:block;height:100%;width:40%;background:var(--green,#3157d5)}.ds-course:focus-visible{outline:3px solid var(--focus,#3157d5);outline-offset:3px;}@media(max-width:760px){.ds-course{grid-template-columns:55px minmax(0,1fr) auto;gap:12px;padding:17px 15px;min-height:108px;border-radius:13px}.ds-course-time{font-size:17px}.ds-course-time small,.ds-course-info>small{font-size:12px}.ds-course-info strong{font-size:16px}.ds-course>svg{display:none}}"
    }
  ],
  "narrative": {
    "northStar": "蓝白馆藏索引",
    "overview": "把馆藏索引的分组、日期和整齐行列转译成日常课务界面：钴蓝标记可操作与选中状态，深墨色保证中文阅读，浅蓝灰画布承托清楚的白色内容区。下一节课程使用深蓝强调面，起床计划使用克制的浅黄功能面，二者通过色调和字号分出层级。\n\n系统无衬线和等宽数字贯穿课程、日期、时刻与表单。界面保持适当密度，用对齐、间距和少量边界建立秩序；图形来自代码、原生控件和线性 SVG，不添加模拟纸纹、装饰编号或栅格图片。明暗主题沿用同一信息关系。",
    "keyCharacteristics": [
      "钴蓝交互、深蓝课程重点、浅黄起床功能区。",
      "中文系统无衬线与等宽数字；课程文字和状态独立于颜色存在。",
      "整齐的日期条、对齐的时间列、直接可点的课程行。",
      "桌面侧栏与手机底栏分别布局；狭窄空间允许换行与日期横向浏览。",
      "平面色调分层为主，只为选项层级和模态浮层保留阴影。"
    ],
    "rules": [
      {
        "name": "The Functional Color Rule",
        "body": "钴蓝用于操作和定位，浅黄用于起床功能区；课程分组色不承诺调度成功，状态必须写出文字。",
        "section": "colors"
      },
      {
        "name": "The Readable Time Rule",
        "body": "时间保持等宽数字，课程名和地点允许换行；不要为整齐外观截断关键安排。",
        "section": "typography"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "普通内容区和课程行使用色面、间距与细边界建立层级；阴影只保留已实现的选中分段和模态浮层用途。",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do 保持钴蓝选择态、深蓝课程重点和浅黄起床区的功能关系。",
      "Do 在课程、日期和状态旁保留可读文字、可见焦点与明确的按钮名称。",
      "Do 用已实现的间距、圆角和系统字体扩展新页面，并为长课程名与地点留出换行空间。",
      "Do 让深色主题切换完整的前景与背景配对，遵守减少动效偏好。",
      "Do 依据实际平台结果显示状态；网页示例使用明确的预览说明。"
    ],
    "donts": [
      "Don't 恢复已被替换的松绿视觉、模拟纸纹或装饰编号。",
      "Don't 把课程分组色变成整张日程行的底色；当前日程行使用中性内容面。",
      "Don't 用大面积阴影、渐变或额外插图填充课务信息区域。",
      "Don't 把桌面主内容直接拉宽为手机版；保留不同导航与内容排列。",
      "Don't 把“已发送免确认请求”改写成“闹钟已设置成功”，也不把浏览器截图当作真机响铃证明。"
    ]
  }
}
